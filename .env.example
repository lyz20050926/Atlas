# Demo: no .env is needed. Run python launch.py (local examples, no AWS/API calls).
# Live: copy this example to .env, fill in YOUR configuration, then run:
#   python launch.py --mode live
# The launcher never overwrites .env. Never include credentials in a submission.
APP_MODE=demo
LLM_PROVIDER=mock
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=
# Use a model or inference-profile ID you have permission to invoke in this region.
BEDROCK_MODEL_ID=
# Optional stronger model for tutoring, questions and feedback; empty uses BEDROCK_MODEL_ID.
BEDROCK_LEARNING_MODEL_ID=
GOOGLE_BOOKS_API_KEY=
# Live storage. Demo is always isolated in data/demo.db by the launcher.
DATABASE_PATH=data/nexmind_atlas.db
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
API_CACHE_TTL_HOURS=24
MAX_SEARCH_RESULTS=6
MAX_SEARCH_ITERATIONS=3
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=65
BEDROCK_MAX_ATTEMPTS=2
